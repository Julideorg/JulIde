{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "julide",
  "version": "0.3.0",
  "identifier": "com.ofek.julide",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "julIDE",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "maximized": false,
        "backgroundColor": "#0E1116"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "frame-src": "'self' blob: http://localhost:* http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: blob: http://localhost:1420",
        "font-src": "'self' data: http://localhost:1420",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob: http://localhost:1420",
        "child-src": "'self' blob:",
        "frame-src": "'self' blob: http://localhost:* http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1421 ws://127.0.0.1:1421 http://localhost:* http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/sinisterMage/julide/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwRjEzRjU4MURFQTREODUKUldTRlRlb2RXRC94WUFXbTc2NHlkMU93UTJtQjlyaW9RN21OS0tlM1dWVzlqZWNqeUFwY042cnMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "publisher": "Ofek Bickel",
    "homepage": "https://github.com/sinisterMage/julide",
    "licenseFile": "../LICENSE",
    "shortDescription": "A modern IDE for the Julia programming language",
    "longDescription": "julIDE is a desktop IDE for Julia built with Tauri and React. It provides a Monaco-based editor with Julia syntax highlighting and snippets, language intelligence via LanguageServer.jl, an integrated REPL with full PTY emulation, a Debugger.jl-backed debugger, plot and rich-output panes, a variable explorer, Pkg.jl package management, git integration via libgit2 with GitHub/GitLab/Gitea support, dev container support, and Pluto.jl notebooks.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "desktopTemplate": "julide.desktop",
        "files": {
          "/usr/share/metainfo/com.ofek.julide.metainfo.xml": "julide.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "julide.desktop",
        "files": {
          "/usr/share/metainfo/com.ofek.julide.metainfo.xml": "julide.metainfo.xml"
        }
      }
    }
  }
}
